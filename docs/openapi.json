    "/api/v1/blood-pressure/summary": {
      "get": {
        "tags": [
          "Blood Pressure"
        ],
        "summary": "Get Bp Summary",
        "description": "Key metrics with grades for the most recent (Current/Latest) timeframe.\n\nPowers the summary card at the top of the BP tab (target vs actual view).",
        "operationId": "get_bp_summary_api_v1_blood_pressure_summary_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start of date range (YYYY-MM-DD)",
              "title": "Start Date"
            },
            "description": "Start of date range (YYYY-MM-DD)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End of date range (YYYY-MM-DD)",
              "title": "End Date"
            },
            "description": "End of date range (YYYY-MM-DD)"
          },
          {
            "name": "temporary_lookup_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Temporary patient lookup code from Healthie",
              "title": "Temporary Lookup Code"
            },
            "description": "Temporary patient lookup code from Healthie"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BPSummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
