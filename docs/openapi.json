    "/api/v1/blood-pressure/download": {
      "get": {
        "tags": [
          "Blood Pressure"
        ],
        "summary": "Download Bp Report",
        "description": "Streams a PDF blood pressure report.\n\nUses LegacyBPAnalysis (from bp_analysis) because BloodPressureReport\nrequires DataFrames (timeframed_df, extremes_df) that the new\nBloodPressureAnalysis class does not expose.\n\nAnalysis is computed server-side; the client no longer sends\npre-rendered JSON (unlike the legacy download endpoint).\n\nReplaces: GET/POST /healthie/iframe_provider_tab/blood_pressure/download",
        "operationId": "download_bp_report_api_v1_blood_pressure_download_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Date"
            }
          },
          {
            "name": "file_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "File Name"
            }
          },
          {
            "name": "include_intro_section",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Intro Section"
            }
          },
          {
            "name": "temporary_lookup_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Temporary patient lookup code from Healthie",
              "title": "Temporary Lookup Code"
            },
            "description": "Temporary patient lookup code from Healthie"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
