  "components": {
    "schemas": {
      "AnalysisRow": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "values": {
            "additionalProperties": {
              "$ref": "#/components/schemas/MetricValue"
            },
            "type": "object",
            "title": "Values"
          },
          "progress": {
            "$ref": "#/components/schemas/MetricProgress"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "values",
          "progress"
        ],
        "title": "AnalysisRow",
        "description": "One row of the analysis table."
      },
      "BMIDataPoint": {
        "properties": {
          "bmi": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bmi"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          }
        },
        "type": "object",
        "title": "BMIDataPoint"
      },
      "BPAnalysisResponse": {
        "properties": {
          "timeframes": {
            "items": {
              "$ref": "#/components/schemas/TimeframeInfo"
            },
            "type": "array",
            "title": "Timeframes"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/AnalysisRow"
            },
            "type": "array",
            "title": "Rows"
          },
          "overall_progress": {
            "$ref": "#/components/schemas/OverallProgress"
          }
        },
        "type": "object",
        "required": [
          "timeframes",
          "rows",
          "overall_progress"
        ],
        "title": "BPAnalysisResponse",
        "description": "Full timeframed analysis table.\n\nPowers the detailed metrics table below the summary card."
      },
      "BPBiometricsResponse": {
        "properties": {
          "physical_activity_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Physical Activity Data"
          },
          "bmi_data": {
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/BMIDataPoint"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Bmi Data"
          },
          "ssq_data": {
            "$ref": "#/components/schemas/SSQData"
          }
        },
        "type": "object",
        "required": [
          "physical_activity_data",
          "bmi_data",
          "ssq_data"
        ],
        "title": "BPBiometricsResponse",
        "description": "Contextual biometric data: physical activity, BMI history, SSQ scores."
      },
      "BPDistributionResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/HourlyDataPoint"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "BPDistributionResponse",
        "description": "Measurement spread by hour of day.\n\nPowers the distribution chart showing when readings tend to be\nhighest/lowest and how variable they are throughout the day."
      },
      "BPExtremesResponse": {
        "properties": {
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/BPMeasurement"
            },
            "type": "array",
            "title": "Measurements"
          }
        },
        "type": "object",
        "required": [
          "measurements"
        ],
        "title": "BPExtremesResponse",
        "description": "Out-of-bounds measurements: SBP < 90, SBP > 170, or DBP > 110."
      },
      "BPHRResponse": {
        "properties": {
          "average_rhr_baseline": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Rhr Baseline"
          },
          "average_rhr_trailing": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Rhr Trailing"
          },
          "average_rhr_prior": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Rhr Prior"
          },
          "baseline_start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Start Date"
          },
          "baseline_end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline End Date"
          },
          "prior_start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Start Date"
          },
          "prior_end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior End Date"
          },
          "current_start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
