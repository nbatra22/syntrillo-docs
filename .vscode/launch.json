{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File (launch.json)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Flask app (launch.json)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "apps/PythonAnywhere/website/flask_app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "autoStartBrowser": false
        },
        {
          "name": "Python Debugger: SRS Data Aggregator",
          "type": "debugpy",
          "request": "launch",
          "module": "sources.syntrillo.stroke_risk_score_v2.agg_data",
          "console": "integratedTerminal"
        },
        {
          "name": "Python Debugger: SRS Iframe DB",
          "type": "debugpy",
          "request": "launch",
          "module": "sources.syntrillo.stroke_risk_score_v2.srs_iframe_db",
          "console": "integratedTerminal"
        },
        {
          "name": "Python Debugger: SRS Risk Score Calculator",
          "type": "debugpy",
          "request": "launch",
          "module": "sources.syntrillo.stroke_risk_score_v2.calc_risk_score",
          "console": "integratedTerminal"
        }
    ]
}