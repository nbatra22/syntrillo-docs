{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Effect": "Allow",
			"Action": "ssm:GetParameters",
			"Resource": [
				"arn:aws:ssm:us-east-1:381491864638:parameter/cdk-bootstrap/hnb659fds/version",
				"arn:aws:ssm:us-east-1:381491864638:parameter/syntrillo-clinic/aws/environment",
				"arn:aws:ssm:us-east-1:381491864638:parameter/syntrillo-clinic/aws/route53/hosted_zone_id"
			]
		},
		{
			"Effect": "Allow",
			"Action": [
				"acm:RequestCertificate",
				"acm:AddTagsToCertificate",
				"acm:DeleteCertificate"
			],
			"Resource": "arn:aws:acm:us-east-1:381491864638:certificate/*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"route53:*"
			],
			"Resource": "arn:aws:route53:::hostedzone/Z007344818F52SMLDPLCV"
		},
		{
			"Effect": "Allow",
			"Action": [
				"secretsmanager:*"
			],
			"Resource": "arn:aws:secretsmanager:us-east-1:381491864638:secret:*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"secretsmanager:GetRandomPassword"
			],
			"Resource": "*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"ec2:*"
			],
			"Resource": [
				"arn:aws:ec2:us-east-1:381491864638:vpc/*",
				"arn:aws:ec2:us-east-1:381491864638:subnet/*",
				"arn:aws:ec2:us-east-1:381491864638:internet-gateway/*",
				"arn:aws:ec2:us-east-1:381491864638:elastic-ip/*",
				"arn:aws:ec2:us-east-1:381491864638:route-table/*",
				"arn:aws:ec2:us-east-1:381491864638:natgateway/*",
				"arn:aws:ec2:us-east-1:381491864638:security-group/*"
			]
		},
		{
			"Effect": "Allow",
			"Action": [
				"rds:*"
			],
			"Resource": "arn:aws:rds:us-east-1:381491864638:*:syntrilloclinicbackend*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"elasticfilesystem:*"
			],
			"Resource": "*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"lambda:*"
			],
			"Resource": "arn:aws:lambda:us-east-1:381491864638:function:SyntrilloClinicBackend*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:DeleteRole",
				"iam:PutRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:AttachRolePolicy",
				"iam:DetachRolePolicy",
				"iam:PassRole",
				"iam:CreateServiceLinkedRole"
			],
			"Resource": "arn:aws:iam::381491864638:role/SyntrilloClinicBackend*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"iam:CreateServiceLinkedRole"
			],
			"Resource": [
				"arn:aws:iam::381491864638:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS"
			]
		}
	]
}